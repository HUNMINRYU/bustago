{
  "contract_version": "1.0",
  "base_url": "http://localhost:5000",
  "endpoints": [
    {
      "path": "/api/predict",
      "method": "GET",
      "description": "혼잡도 예측",
      "parameters": {
        "station_id": {"type": "string", "required": true, "description": "정류장 ARS 번호 (예: 22011)"},
        "hour": {"type": "integer", "required": true, "min": 0, "max": 23, "description": "시간대 (0~23)"},
        "weekday": {"type": "integer", "required": false, "min": 0, "max": 6, "description": "요일 (0=월~6=일, 미지정 시 오늘)"}
      },
      "response": {
        "status": "ok",
        "data": {
          "station_id": "22011",
          "station_name": "지하철2호선강남역",
          "hour": 8,
          "weekday": 1,
          "prediction": {
            "level": 2,
            "label": "혼잡",
            "probabilities": [0.1, 0.2, 0.5, 0.2]
          },
          "recommendation": "혼잡이 예상됩니다. 다음 시간대를 추천합니다.",
          "next_hour_prediction": {
            "level": 1,
            "label": "보통"
          }
        },
        "timestamp": "2026-03-30T14:00:00"
      },
      "error_response": {
        "status": "error",
        "message": "station_id is required",
        "code": 400
      }
    },
    {
      "path": "/api/stats",
      "method": "GET",
      "description": "정류장 통계 조회",
      "parameters": {
        "station_id": {"type": "string", "required": true, "description": "정류장 ARS 번호"},
        "period": {"type": "string", "required": false, "enum": ["today", "week", "month"], "default": "today", "description": "조회 기간"}
      },
      "response": {
        "status": "ok",
        "data": {
          "station_id": "22011",
          "period": "today",
          "hourly_stats": [
            {"hour": 0, "avg_level": null},
            {"hour": 8, "avg_level": 2.5}
          ],
          "total_predictions": 10
        },
        "timestamp": "2026-03-30T14:00:00"
      }
    },
    {
      "path": "/api/stations",
      "method": "GET",
      "description": "정류장 목록 조회",
      "parameters": {},
      "response": {
        "status": "ok",
        "data": [
          {
            "ars_no": "22011",
            "station_name": "지하철2호선강남역",
            "latitude": 37.4979502,
            "longitude": 127.0276368
          }
        ],
        "timestamp": "2026-03-30T14:00:00"
      }
    },
    {
      "path": "/api/weather/current",
      "method": "GET",
      "description": "현재 날씨 정보 (기상청 API 프록시)",
      "parameters": {},
      "response": {
        "status": "ok",
        "data": {
          "weather": 0,
          "temperature": 20.0,
          "rain": 0,
          "humidity": 50,
          "wind_speed": 2.0,
          "cached": false,
          "fallback": true
        },
        "timestamp": "2026-03-30T14:00:00"
      }
    },
    {
      "path": "/api/health",
      "method": "GET",
      "description": "서버 헬스 체크",
      "parameters": {},
      "response": {
        "status": "ok",
        "timestamp": "2026-03-30T14:00:00"
      }
    }
  ],
  "common": {
    "response_format": {
      "success": {"status": "ok", "data": "...", "timestamp": "ISO 8601"},
      "error": {"status": "error", "message": "...", "code": "HTTP status code"}
    },
    "congestion_levels": {
      "0": "여유",
      "1": "보통",
      "2": "혼잡",
      "3": "매우혼잡"
    },
    "weather_codes": {
      "0": "맑음",
      "1": "흐림",
      "2": "비",
      "3": "눈"
    }
  }
}
