# BUSTAGO 환경변수 템플릿
# =============================================
# 실제 값은 `.env` 파일에 적고 절대 git에 커밋하지 말 것 (.gitignore로 자동 제외됨).
# 본 .env.example만 Git에 트래킹.
# 2026-05-16 진단 §6/§8 P0 반영: config.py 하드코딩 fallback 제거. .env 필수.

# ----- Flask -----
FLASK_DEBUG=0
FLASK_PORT=5000

# ----- DB (MySQL 우선, 미설정/실패 시 SQLite 폴백) -----
# 주의: 변수명은 config.py의 os.getenv()와 정확히 일치 (MYSQL_*).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=bustago

# ----- 광주광역시 버스정보시스템 API (필수, backend/routes/stations.py) -----
# 공공데이터포털 (https://www.data.go.kr/data/15043867/openapi.do) 에서 발급.
# 빈 값이면 /api/arrive · /api/lines · /api/gj-stops가 빈 응답/502 반환.
# 시작 시 config.py가 RuntimeWarning + stderr 메시지로 알림.
GJ_BIS_API_KEY=
GJ_BIS_BASE_URL=https://apis.data.go.kr/6290000/gj_bis

# ----- 기상청 단기예보 API (선택, backend/routes/stations.py weather) -----
# 빈 값이면 stations.py에서 기본 날씨(맑음/20°C) 반환. 시연 운영에 영향 작음.
WEATHER_API_KEY=
WEATHER_API_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst

# ----- 서울 열린데이터광장 API (데이터 수집 전용, ml/data_collection/) -----
# 서울시 승하차 데이터 수집 시 필요. 시연 운영에는 무관.
# 발급: https://data.seoul.go.kr
SEOUL_OPENDATA_API_KEY=

# ----- 공공데이터포털 통합 API (데이터 수집 전용) -----
# 차내 혼잡도 / 기상 등 추가 수집 시 필요. 시연 운영에는 무관.
# 발급: https://data.go.kr
DATA_GO_KR_API_KEY=
