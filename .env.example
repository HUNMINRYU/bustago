# Flask
FLASK_DEBUG=0

# Database (MySQL 우선, SQLite fallback)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bustago
DB_USER=root
DB_PASSWORD=

# API Keys
WEATHER_API_KEY=

# 서울 열린데이터광장 API 키 (https://data.seoul.go.kr 에서 발급)
SEOUL_OPENDATA_API_KEY=여기에_서울열린데이터_API키_입력

# 공공데이터포털 API 키 (https://data.go.kr 에서 발급)
DATA_GO_KR_API_KEY=여기에_공공데이터포털_API키_입력

# 광주광역시 버스정보시스템 API (공공데이터포털 6290000/gj_bis)
# 기본값이 config.py에 하드코딩돼 있어 개발 환경에서는 설정 불필요
GJ_BIS_API_KEY=
